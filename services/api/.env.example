# Railway sets PORT automatically
PORT=8787

# Must match API_SHARED_SECRET in the Next.js app (Vercel)
API_SHARED_SECRET=

# Twilio (optional; SMS alerts are skipped until all four are set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_TO_NUMBER=

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=https://www.raoatech.com
