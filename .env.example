# Copy to .env.local for local development. Every integration is optional:
# a missing key switches that feature off instead of breaking the build.

# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.raoatech.com

# Supabase (database) — Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (errors + session replay)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Twilio (optional): texts NOTIFY_TO_NUMBER about each new enquiry
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_TO_NUMBER=

# Railway backend (services/api, optional). Used for SMS only if the Twilio keys above are not set.
API_URL=
API_SHARED_SECRET=
