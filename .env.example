# Copy to .env.local for local development. Every integration is optional:
# a missing key switches that feature off instead of breaking the build.

# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.raoatech.com

# Supabase (database) — Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (email). Each enquiry is emailed to ENQUIRY_TO_EMAIL (defaults to the address in content/site.ts).
# ENQUIRY_FROM_EMAIL must be on a domain verified in Resend; until then leave it blank and
# sign up to Resend with the receiving address so the default sender can deliver to it.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@raoatechlabs.com
ENQUIRY_FROM_EMAIL=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (errors + session replay)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Railway backend (services/api). The site pings it after each enquiry.
API_URL=
API_SHARED_SECRET=
